generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  passwordHash          String
  name                  String
  phone                 String?
  role                  Role
  isPatron              Boolean                @default(false)
  isVerified            Boolean                @default(false)
  isActive              Boolean                @default(true)
  permissions           Json                   @default("{}")
  mustChangePassword    Boolean                @default(false)
  profilePicture        String?
  lastLoginAt           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  auditLogs             AuditLog[]
  bookings              Booking[]
  patronBookings        Booking[]              @relation("BookingPatron")
  approvedBookings      Booking[]              @relation("BookingApprovedBy")
  approvedExpenses      Expense[]              @relation("ApprovedExpenses")
  createdExpenses       Expense[]              @relation("CreatedExpenses")
  createdIncome         Income[]
  inventoryCheckouts    InventoryCheckout[]    @relation("CheckedOutBy")
  inventoryReturns      InventoryCheckout[]    @relation("ReturnedBy")
  invMaintAssigned      InventoryMaintenance[] @relation("InvMaintAssigned")
  invMaintRequested     InventoryMaintenance[] @relation("InvMaintRequested")
  assignedMaint         MaintenanceRequest[]   @relation("AssignedMaint")
  requestedMaint        MaintenanceRequest[]   @relation("RequestedMaint")
  facilityCheckIns      FacilityCheckIn[]      @relation("FacilityCheckIns")
  facilityCheckOuts     FacilityCheckIn[]      @relation("FacilityCheckOuts")
  activatedCodes        CeremonyBookingCode[]
  ceremonyDateOverrides CeremonyDateOverride[]
  savingsTransactions   SavingsTransaction[]
  dutyLogsAssigned      DutyLog[]              @relation("DutyAssignedTo")
  dutyLogsCreated       DutyLog[]              @relation("DutyCreatedBy")
  dutyLogsSupervised    DutyLog[]              @relation("DutySupervisor")
  dutyItemsSigned       DutyLogItem[]          @relation("DutyItemSignedBy")
  tasksCreated          Task[]                 @relation("TasksCreated")
  tasksAssigned         Task[]                 @relation("TasksAssigned")
  resolvedFeedback      FacilityFeedback[]     @relation("ResolvedFeedback")

  @@index([role])
  @@index([role, isActive])
  @@index([isPatron, isActive])
  @@map("users")
}

model Facility {
  id                       String                         @id @default(cuid())
  name                     String
  description              String?
  capacity                 Int
  requiresBookingTerms     Boolean                        @default(true)
  requiresItemBookingTerms Boolean                        @default(false)
  amenities                String[]
  images                   String[]
  isActive                 Boolean                        @default(true)
  underMaintenance         Boolean                        @default(false)
  availableFrom            String                         @default("08:00")
  availableTo              String                         @default("22:00")
  acUsageFee               Decimal                        @default(0) @db.Decimal(10, 2)
  availableDays            Int[]
  latitude                 Float?
  longitude                Float?
  hasAccessCode            Boolean                        @default(false)
  accessCode               String?
  deletedAt                DateTime?
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt
  maintenanceEndsAt        DateTime?
  maintenanceStartsAt      DateTime?
  sortOrder                Int                            @default(0)
  bookings                 Booking[]
  pricing                  FacilityPricing[]
  timeSlots                FacilityTimeSlot[]
  maintenance              MaintenanceRequest[]
  inventoryRequirements    FacilityInventoryRequirement[]
  ceremonyConfigs          CeremonyVenueConfig[]
  ceremonyCodes            CeremonyBookingCode[]
  feedback                 FacilityFeedback[]

  @@index([isActive])
  @@map("facilities")
}

model FacilityPricing {
  id          String             @id @default(cuid())
  facilityId  String
  category    String
  price       Decimal            @db.Decimal(10, 2)
  description String?
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  freeDays    Int[]              @default([])
  facility    Facility           @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  timeSlots   FacilityTimeSlot[]

  @@unique([facilityId, category])
  @@index([facilityId, isActive])
  @@map("facility_pricing")
}

model FacilityTimeSlot {
  id                   String          @id @default(cuid())
  facilityId           String
  category             String
  dayOfWeek            Int
  startTime            String
  endTime              String
  label                String
  isFlexible           Boolean         @default(false)
  maxBookings          Int             @default(1)
  isActive             Boolean         @default(true)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  isFree               Boolean         @default(false)
  pricePerHourOverride Decimal?        @db.Decimal(10, 2)
  facility             Facility        @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  pricing              FacilityPricing @relation(fields: [facilityId, category], references: [facilityId, category], onDelete: Cascade)

  @@index([facilityId, category, dayOfWeek, isActive])
  @@map("facility_time_slots")
}

model Booking {
  id                    String               @id @default(cuid())
  facilityId            String?
  userId                String?
  patronId              String?
  category              String               @default("OTHER")
  title                 String
  description           String?
  startTime             DateTime
  endTime               DateTime
  status                BookingStatus        @default(PENDING)
  totalAmount           Decimal              @db.Decimal(10, 2)
  resolvedUnitPrice     Decimal              @default(0) @db.Decimal(10, 2)
  resolvedPricingSource String               @default("CATEGORY_BASE")
  notes                 String?
  acRequested           Boolean              @default(false)
  checkInRequested      Boolean              @default(false)
  checkInRequestedAt    DateTime?
  rejectionReason       String?
  deletedAt             DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  isBillingWaived       Boolean              @default(false)
  ceremonyDetails       Json?
  approvedById          String?
  approvedAt            DateTime?
  lineItems             BookingLineItem[]
  facility              Facility?            @relation(fields: [facilityId], references: [id])
  patron                User?                @relation("BookingPatron", fields: [patronId], references: [id])
  user                  User?                @relation(fields: [userId], references: [id])
  approvedBy            User?                @relation("BookingApprovedBy", fields: [approvedById], references: [id])
  income                Income?
  checkIn               FacilityCheckIn?
  ceremonyCode          CeremonyBookingCode?

  @@index([facilityId, startTime, endTime])
  @@index([facilityId, status, deletedAt])
  @@index([status])
  @@index([category])
  @@index([approvedById])
  @@map("bookings")
}

model BookableItem {
  id                       String            @id @default(cuid())
  name                     String
  description              String?
  unit                     String            @default("piece")
  requiresBookingTerms     Boolean           @default(false)
  requiresItemBookingTerms Boolean           @default(true)
  pricePerUnit             Decimal           @db.Decimal(10, 2)
  quantity                 Int               @default(1)
  images                   String[]
  tags                     String[]
  isActive                 Boolean           @default(true)
  sortOrder                Int               @default(0)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  bookingLines             BookingLineItem[]
  bundleComponents         BundleComponent[]

  @@index([isActive])
  @@map("bookable_items")
}

model BookableBundle {
  id                       String            @id @default(cuid())
  name                     String
  description              String?
  tagline                  String?
  requiresBookingTerms     Boolean           @default(false)
  requiresItemBookingTerms Boolean           @default(true)
  price                    Decimal           @db.Decimal(10, 2)
  images                   String[]
  tags                     String[]
  isActive                 Boolean           @default(true)
  sortOrder                Int               @default(0)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  bookingLines             BookingLineItem[]
  components               BundleComponent[]

  @@index([isActive])
  @@map("bookable_bundles")
}

model BundleComponent {
  id       String         @id @default(cuid())
  bundleId String
  itemId   String
  quantity Int            @default(1)
  label    String?
  bundle   BookableBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  item     BookableItem   @relation(fields: [itemId], references: [id])

  @@unique([bundleId, itemId])
  @@index([itemId])
  @@map("bundle_components")
}

model BookingLineItem {
  id        String          @id @default(cuid())
  bookingId String
  itemId    String?
  bundleId  String?
  quantity  Int             @default(1)
  unitPrice Decimal         @db.Decimal(10, 2)
  subtotal  Decimal         @db.Decimal(10, 2)
  booking   Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bundle    BookableBundle? @relation(fields: [bundleId], references: [id])
  item      BookableItem?   @relation(fields: [itemId], references: [id])

  @@index([bookingId])
  @@index([bundleId])
  @@index([itemId])
  @@map("booking_line_items")
}

model Expense {
  id                   String              @id @default(cuid())
  createdById          String
  approvedById         String?
  title                String
  narration            String
  amount               Decimal             @db.Decimal(10, 2)
  category             String
  status               ExpenseStatus       @default(PENDING)
  receiptUrl           String?
  rejectionReason      String?
  /// The date the money was actually spent (supports backdated entries). Nullable for
  /// legacy rows — code falls back to approvedAt/createdAt when unset.
  spentAt              DateTime?
  deletedAt            DateTime?
  createdAt            DateTime            @default(now())
  approvedAt           DateTime?
  updatedAt            DateTime            @updatedAt
  maintenanceRequestId String?             @unique
  isTransactionCharge  Boolean             @default(false)
  chargeExpenseId      String?             @unique
  accountId            String?
  approvedBy           User?               @relation("ApprovedExpenses", fields: [approvedById], references: [id])
  createdBy            User                @relation("CreatedExpenses", fields: [createdById], references: [id])
  maintenanceRequest   MaintenanceRequest? @relation(fields: [maintenanceRequestId], references: [id])
  chargeExpense        Expense?            @relation("ChargeExpense", fields: [chargeExpenseId], references: [id])
  linkedExpense        Expense?            @relation("ChargeExpense")
  account              Account?            @relation(fields: [accountId], references: [id])

  @@index([status])
  @@index([accountId])
  @@map("expenses")
}

/**
 * Independent, FM-managed money accounts (e.g. "Expense Account", a bank account, mobile
 * money, cash). Every account tracks its own balance — income recorded against it, minus
 * approved expenses paid from it, minus/plus savings transfers moved to/from it. Accounts
 * are never deleted, only deactivated, since they're referenced by financial history.
 */
model Account {
  id                  String               @id @default(cuid())
  name                String
  isActive            Boolean              @default(true)
  sortOrder           Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  expenses            Expense[]
  incomes             Income[]
  savingsTransactions SavingsTransaction[]

  @@index([isActive, sortOrder])
  @@map("accounts")
}

model Income {
  id           String    @id @default(cuid())
  recordedById String?
  title        String
  narration    String
  amount       Decimal   @db.Decimal(10, 2)
  category     String
  source       String?
  receivedAt   DateTime
  createdAt    DateTime  @default(now())
  bookingId    String?   @unique
  deletedAt    DateTime?
  accountId    String?
  booking      Booking?  @relation(fields: [bookingId], references: [id])
  recordedBy   User?     @relation(fields: [recordedById], references: [id])
  account      Account?  @relation(fields: [accountId], references: [id])

  @@index([receivedAt])
  @@index([receivedAt, deletedAt])
  @@index([accountId])
  @@map("income")
}

/**
 * A transfer between the savings pool and one operating Account. `accountId` is the
 * counterparty account: the source for a DEPOSIT (money leaving that account into savings)
 * or the destination for a WITHDRAWAL (money leaving savings into that account).
 */
model SavingsTransaction {
  id          String                 @id @default(cuid())
  type        SavingsTransactionType
  amount      Decimal                @db.Decimal(10, 2)
  narration   String
  createdById String
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  accountId   String?
  createdBy   User                   @relation(fields: [createdById], references: [id])
  account     Account?               @relation(fields: [accountId], references: [id])

  @@index([type, createdAt])
  @@index([accountId])
  @@map("savings_transactions")
}

model MaintenanceRequest {
  id             String              @id @default(cuid())
  facilityId     String?
  requestedById  String
  assignedToId   String?
  title          String
  description    String
  priority       MaintenancePriority @default(MEDIUM)
  status         MaintenanceStatus   @default(OPEN)
  estimatedCost  Decimal?            @db.Decimal(10, 2)
  actualCost     Decimal?            @db.Decimal(10, 2)
  resolvedAt     DateTime?
  closedAt       DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  scheduledEnd   DateTime?
  scheduledStart DateTime?
  assignedTo     User?               @relation("AssignedMaint", fields: [assignedToId], references: [id])
  facility       Facility?           @relation(fields: [facilityId], references: [id])
  requestedBy    User                @relation("RequestedMaint", fields: [requestedById], references: [id])
  expense        Expense?
  task           Task?

  @@index([status, priority])
  @@map("maintenance_requests")
}

// ─── Personal Tasks (quick-capture inbox for staff) ───────────────────────────

model Task {
  id                   String              @id @default(cuid())
  title                String
  priority             TaskPriority?
  dueDate              DateTime?
  completedAt          DateTime?
  createdById          String
  assignedToId         String?
  maintenanceRequestId String?             @unique
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  createdBy            User                @relation("TasksCreated", fields: [createdById], references: [id])
  assignedTo           User?               @relation("TasksAssigned", fields: [assignedToId], references: [id])
  maintenanceRequest   MaintenanceRequest? @relation(fields: [maintenanceRequestId], references: [id])

  @@index([createdById, completedAt])
  @@index([assignedToId, completedAt])
  @@map("tasks")
}

model InventoryCategory {
  id          String          @id @default(cuid())
  name        String
  description String?
  icon        String?
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       InventoryItem[]

  @@map("inventory_categories")
}

model InventoryItem {
  id                   String                         @id @default(cuid())
  categoryId           String?
  name                 String
  description          String?
  serialNumber         String?
  assetTag             String?                        @unique
  condition            InventoryCondition             @default(GOOD)
  status               InventoryStatus                @default(AVAILABLE)
  location             String?
  quantity             Int                            @default(1)
  unitCost             Decimal?                       @db.Decimal(10, 2)
  purchaseDate         DateTime?
  supplier             String?
  warrantyExp          DateTime?
  notes                String?
  images               String[]
  isActive             Boolean                        @default(true)
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  checkouts            InventoryCheckout[]
  category             InventoryCategory?             @relation(fields: [categoryId], references: [id])
  maintenanceLogs      InventoryMaintenance[]
  facilityRequirements FacilityInventoryRequirement[]

  @@index([status, isActive])
  @@map("inventory_items")
}

model InventoryCheckout {
  id             String              @id @default(cuid())
  itemId         String
  checkedOutById String
  returnedById   String?
  purpose        String
  quantity       Int                 @default(1)
  locationNote   String?
  checkedOutAt   DateTime            @default(now())
  dueBack        DateTime?
  returnedAt     DateTime?
  conditionOut   InventoryCondition  @default(GOOD)
  conditionIn    InventoryCondition?
  notes          String?
  checkedOutBy   User                @relation("CheckedOutBy", fields: [checkedOutById], references: [id])
  item           InventoryItem       @relation(fields: [itemId], references: [id])
  returnedBy     User?               @relation("ReturnedBy", fields: [returnedById], references: [id])

  @@index([itemId])
  @@index([checkedOutById])
  @@map("inventory_checkouts")
}

model InventoryMaintenance {
  id            String              @id @default(cuid())
  itemId        String
  requestedById String
  assignedToId  String?
  title         String
  description   String
  priority      MaintenancePriority @default(MEDIUM)
  status        MaintenanceStatus   @default(OPEN)
  estimatedCost Decimal?            @db.Decimal(10, 2)
  actualCost    Decimal?            @db.Decimal(10, 2)
  resolvedAt    DateTime?
  closedAt      DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  assignedTo    User?               @relation("InvMaintAssigned", fields: [assignedToId], references: [id])
  item          InventoryItem       @relation(fields: [itemId], references: [id])
  requestedBy   User                @relation("InvMaintRequested", fields: [requestedById], references: [id])

  @@index([status, priority])
  @@map("inventory_maintenance")
}

model NotificationLog {
  id          String   @id @default(cuid())
  type        String
  recipient   String
  subject     String?
  body        String
  status      String
  provider    String
  providerRef String?
  error       String?
  sentAt      DateTime @default(now())

  @@index([type, status])
  @@map("notification_logs")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([action, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

enum Role {
  SUPER_ADMIN
  FACILITY_MANAGER
  BOOKING_MANAGER
  VICAR
  STAFF
  PATRON
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SavingsTransactionType {
  DEPOSIT
  WITHDRAWAL
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FacilityFeedbackType {
  COMPLAINT
  FEEDBACK
  SUGGESTION
}

enum FacilityFeedbackStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum InventoryCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  DAMAGED
  DISPOSED
}

enum InventoryStatus {
  AVAILABLE
  IN_USE
  CHECKED_OUT
  UNDER_MAINTENANCE
  DISPOSED
  LOST
}

// ─── Booking Categories (dynamic, managed by FM / Super Admin) ────────────────

model BookingCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("booking_categories")
}

// ─── Duty Logs (staff duty checklists) ────────────────────────────────────────

enum DutyTemplateType {
  TIMED_LOG
  END_OF_SHIFT
  CHECKLIST
}

enum DutyTimeType {
  SPECIFIC
  END_OF_DAY
  CONTINUOUS
}

enum DutyLogStatus {
  ACTIVE
  COMPLETED
  SIGNED_OFF
}

model DutyTemplate {
  id        String           @id @default(cuid())
  name      String
  type      DutyTemplateType
  isActive  Boolean          @default(true)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  items    DutyTemplateItem[]
  dutyLogs DutyLog[]

  @@map("duty_templates")
}

model DutyTemplateItem {
  id            String       @id @default(cuid())
  templateId    String
  sortOrder     Int
  timeType      DutyTimeType @default(SPECIFIC)
  scheduledTime String?
  description   String

  template DutyTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, sortOrder])
  @@map("duty_template_items")
}

model DutyLog {
  id                 String        @id @default(cuid())
  templateId         String
  date               DateTime      @db.Date
  assignedToId       String
  createdById        String
  status             DutyLogStatus @default(ACTIVE)
  assigneeSignedAt   DateTime?
  supervisorId       String?
  supervisorSignedAt DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  template   DutyTemplate  @relation(fields: [templateId], references: [id])
  assignedTo User          @relation("DutyAssignedTo", fields: [assignedToId], references: [id])
  createdBy  User          @relation("DutyCreatedBy", fields: [createdById], references: [id])
  supervisor User?         @relation("DutySupervisor", fields: [supervisorId], references: [id])
  items      DutyLogItem[]

  @@unique([templateId, date, assignedToId])
  @@index([date])
  @@index([assignedToId])
  @@map("duty_logs")
}

model DutyLogItem {
  id            String       @id @default(cuid())
  dutyLogId     String
  sortOrder     Int
  timeType      DutyTimeType @default(SPECIFIC)
  scheduledTime String?
  description   String
  isDone        Boolean      @default(false)
  completedAt   DateTime?
  signedById    String?

  dutyLog  DutyLog @relation(fields: [dutyLogId], references: [id], onDelete: Cascade)
  signedBy User?   @relation("DutyItemSignedBy", fields: [signedById], references: [id])

  @@index([dutyLogId, sortOrder])
  @@map("duty_log_items")
}

// ─── Facility Inventory Requirements ─────────────────────────────────────────
// Defines which inventory items a facility needs when in use.
// Used to allocate / reserve items automatically when a booking is approved.

model FacilityInventoryRequirement {
  id         String        @id @default(cuid())
  facilityId String
  itemId     String
  quantity   Int           @default(1)
  isRequired Boolean       @default(true) // false = optional / nice-to-have
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  facility   Facility      @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  item       InventoryItem @relation(fields: [itemId], references: [id])

  @@unique([facilityId, itemId])
  @@index([facilityId])
  @@map("facility_inventory_requirements")
}

// ─── Facility Check-In / Check-Out ───────────────────────────────────────────
// Tracks the physical presence of a patron / user at a facility for a booking.
// One record per booking; checkedOutAt is NULL until the occupant leaves.

model FacilityCheckIn {
  id             String    @id @default(cuid())
  bookingId      String    @unique
  checkedInById  String // staff member who performed the check-in
  checkedOutById String? // staff member who performed the check-out
  checkedInAt    DateTime  @default(now())
  checkedOutAt   DateTime?
  notes          String?
  booking        Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  checkedInBy    User      @relation("FacilityCheckIns", fields: [checkedInById], references: [id])
  checkedOutBy   User?     @relation("FacilityCheckOuts", fields: [checkedOutById], references: [id])

  @@index([checkedInAt])
  @@map("facility_check_ins")
}

// ─── Push Notification Subscriptions ─────────────────────────────────────────
// Stores Web Push API subscriptions so the server can send push notifications.
// A user/patron may have multiple devices subscribed.

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String?
  patronId  String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([patronId])
  @@map("push_subscriptions")
}

// ─── Ceremony Booking Support ─────────────────────────────────────────────────

enum CeremonyType {
  WEDDING
  NAMING
}

enum CeremonyCodeStatus {
  PENDING
  ACTIVE
  USED
  EXPIRED
}

model CeremonyVenueConfig {
  id          String       @id @default(cuid())
  facilityId  String
  type        CeremonyType
  images      String[]
  price       Decimal      @db.Decimal(10, 2)
  description String?
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, type])
  @@index([type, isActive])
  @@map("ceremony_venue_configs")
}

model CeremonyBookingCode {
  id             String             @id @default(cuid())
  code           String             @unique
  status         CeremonyCodeStatus @default(PENDING)
  ceremonyType   CeremonyType
  facilityId     String?
  amountPaid     Decimal?           @db.Decimal(10, 2)
  requesterName  String
  requesterPhone String
  requesterEmail String
  notes          String?
  receiptUrl     String?
  expiresAt      DateTime?
  activatedAt    DateTime?
  activatedById  String?
  usedAt         DateTime?
  bookingId      String?            @unique
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  activatedBy User?     @relation(fields: [activatedById], references: [id])
  booking     Booking?  @relation(fields: [bookingId], references: [id])
  facility    Facility? @relation(fields: [facilityId], references: [id])

  @@index([status])
  @@index([requesterEmail])
  @@index([facilityId])
  @@map("ceremony_booking_codes")
}

enum CeremonyDateOverrideType {
  ADD
  EXCLUDE
}

/**
 * Admin-managed adjustments to the automatic ceremony-day calendar (first
 * Saturday of every month). ADD designates an extra Saturday as a ceremony
 * day; EXCLUDE removes an otherwise-automatic first Saturday (e.g. a holiday
 * or a month the office wants closed for ceremonies) — see isCeremonyDay().
 */
model CeremonyDateOverride {
  id          String                   @id @default(cuid())
  date        DateTime // stored at noon UTC; must be a Saturday
  type        CeremonyDateOverrideType @default(ADD)
  note        String?
  createdById String
  createdAt   DateTime                 @default(now())

  createdBy User @relation(fields: [createdById], references: [id])

  @@unique([date])
  @@map("ceremony_date_overrides")
}

/**
 * Officiating bishops selectable on the wedding / naming ceremony booking forms.
 */
model Bishop {
  id        String   @id @default(cuid())
  name      String
  phone     String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("bishops")
}

// ─── Public facility feedback / complaints ───────────────────────────────────

model FacilityFeedback {
  id             String                 @id @default(cuid())
  type           FacilityFeedbackType
  isAnonymous    Boolean                @default(false)
  submitterName  String?
  submitterEmail String?
  submitterPhone String?
  facilityId     String?
  subject        String
  message        String
  status         FacilityFeedbackStatus @default(OPEN)
  adminNotes     String?
  resolvedAt     DateTime?
  resolvedById   String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  facility   Facility? @relation(fields: [facilityId], references: [id])
  resolvedBy User?     @relation("ResolvedFeedback", fields: [resolvedById], references: [id])

  @@index([status, createdAt])
  @@map("facility_feedback")
}

// ─── Site Settings (key-value store for FM-editable config) ──────────────────

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// ─── Report Subscriptions (scheduled automated email reports) ─────────────────

model ReportSubscription {
  id        String   @id @default(cuid())
  email     String
  name      String
  frequency String // "WEEKLY" | "MONTHLY" | "QUARTERLY" | "YEARLY"
  reports   String[] // ["FINANCIAL","BOOKINGS","FACILITIES","MAINTENANCE","CEREMONY","INVENTORY","PATRONS"]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([frequency, isActive])
  @@map("report_subscriptions")
}
