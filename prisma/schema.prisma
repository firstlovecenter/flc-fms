generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String                 @id @default(cuid())
  email              String                 @unique
  passwordHash       String
  name               String
  phone              String?
  role               Role
  isActive           Boolean                @default(true)
  permissions        Json                   @default("{}")
  mustChangePassword Boolean                @default(false)
  profilePicture     String?
  lastLoginAt        DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  auditLogs          AuditLog[]
  bookings           Booking[]
  ceremonyDays       CeremonyDay[]
  createdEvents      Event[]
  approvedExpenses   Expense[]              @relation("ApprovedExpenses")
  createdExpenses    Expense[]              @relation("CreatedExpenses")
  createdIncome      Income[]
  inventoryCheckouts InventoryCheckout[]    @relation("CheckedOutBy")
  inventoryReturns   InventoryCheckout[]    @relation("ReturnedBy")
  invMaintAssigned   InventoryMaintenance[] @relation("InvMaintAssigned")
  invMaintRequested  InventoryMaintenance[] @relation("InvMaintRequested")
  assignedMaint      MaintenanceRequest[]   @relation("AssignedMaint")
  requestedMaint     MaintenanceRequest[]   @relation("RequestedMaint")

  @@index([role])
  @@map("users")
}

model Patron {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?   @unique
  isVerified   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bookings     Booking[]
  payments     Payment[]

  @@map("patrons")
}

model Facility {
  id                  String               @id @default(cuid())
  name                String
  description         String?
  capacity            Int
  pricePerHour        Decimal              @db.Decimal(10, 2)
  pricePerDay         Decimal?             @db.Decimal(10, 2)
  amenities           String[]
  images              String[]
  isActive            Boolean              @default(true)
  underMaintenance    Boolean              @default(false)
  availableFrom       String               @default("08:00")
  availableTo         String               @default("22:00")
  availableDays       Int[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  maintenanceEndsAt   DateTime?
  maintenanceStartsAt DateTime?
  sortOrder           Int                  @default(0)
  bookings            Booking[]
  ceremonyDays        CeremonyDay[]
  events              Event[]
  pricing             FacilityPricing[]
  timeSlots           FacilityTimeSlot[]
  maintenance         MaintenanceRequest[]

  @@index([isActive])
  @@map("facilities")
}

model FacilityPricing {
  id           String   @id @default(cuid())
  facilityId   String
  category     String
  pricePerHour Decimal  @db.Decimal(10, 2)
  pricePerDay  Decimal? @db.Decimal(10, 2)
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  freeDays     Int[]    @default([])
  facility     Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, category])
  @@index([facilityId, isActive])
  @@map("facility_pricing")
}

model FacilityTimeSlot {
  id                   String   @id @default(cuid())
  facilityId           String
  category             String?
  dayOfWeek            Int
  startTime            String
  endTime              String
  label                String
  isFlexible           Boolean  @default(false)
  maxBookings          Int      @default(1)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  isFree               Boolean  @default(false)
  pricePerHourOverride Decimal? @db.Decimal(10, 2)
  facility             Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, dayOfWeek, isActive])
  @@map("facility_time_slots")
}

model CeremonyDay {
  id          String             @id @default(cuid())
  facilityId  String
  date        DateTime           @db.Date
  title       String?
  notes       String?
  isActive    Boolean            @default(true)
  createdById String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  createdBy   User               @relation(fields: [createdById], references: [id])
  facility    Facility           @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  timeSlots   CeremonyTimeSlot[]

  @@unique([facilityId, date])
  @@index([facilityId, date, isActive])
  @@map("ceremony_days")
}

model CeremonyTimeSlot {
  id            String      @id @default(cuid())
  ceremonyDayId String
  category      String
  startTime     String
  endTime       String
  label         String
  maxBookings   Int         @default(1)
  pricePerHour  Decimal?    @db.Decimal(10, 2)
  isFree        Boolean     @default(false)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  ceremonyDay   CeremonyDay @relation(fields: [ceremonyDayId], references: [id], onDelete: Cascade)

  @@index([ceremonyDayId, category, isActive])
  @@map("ceremony_time_slots")
}

model Booking {
  id              String            @id @default(cuid())
  facilityId      String?
  userId          String?
  patronId        String?
  eventId         String?
  category        String            @default("OTHER")
  title           String
  description     String?
  startTime       DateTime
  endTime         DateTime
  status          BookingStatus     @default(PENDING)
  paymentStatus   PaymentStatus     @default(UNPAID)
  totalAmount     Decimal           @db.Decimal(10, 2)
  notes           String?
  rejectionReason String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  isBillingWaived Boolean           @default(false)
  lineItems       BookingLineItem[]
  event           Event?            @relation(fields: [eventId], references: [id])
  facility        Facility?         @relation(fields: [facilityId], references: [id])
  patron          Patron?           @relation(fields: [patronId], references: [id])
  user            User?             @relation(fields: [userId], references: [id])
  income          Income?
  payment         Payment?
  receipt         Receipt?

  @@index([facilityId, startTime, endTime])
  @@index([status])
  @@map("bookings")
}

model BookableItem {
  id               String            @id @default(cuid())
  name             String
  description      String?
  unit             String            @default("piece")
  pricePerUnit     Decimal           @db.Decimal(10, 2)
  quantity         Int               @default(1)
  images           String[]
  tags             String[]
  isActive         Boolean           @default(true)
  sortOrder        Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  bookingLines     BookingLineItem[]
  bundleComponents BundleComponent[]

  @@index([isActive])
  @@map("bookable_items")
}

model BookableBundle {
  id           String            @id @default(cuid())
  name         String
  description  String?
  tagline      String?
  price        Decimal           @db.Decimal(10, 2)
  images       String[]
  tags         String[]
  isActive     Boolean           @default(true)
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  bookingLines BookingLineItem[]
  components   BundleComponent[]

  @@index([isActive])
  @@map("bookable_bundles")
}

model BundleComponent {
  id       String         @id @default(cuid())
  bundleId String
  itemId   String
  quantity Int            @default(1)
  label    String?
  bundle   BookableBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  item     BookableItem   @relation(fields: [itemId], references: [id])

  @@unique([bundleId, itemId])
  @@map("bundle_components")
}

model BookingLineItem {
  id        String          @id @default(cuid())
  bookingId String
  itemId    String?
  bundleId  String?
  quantity  Int             @default(1)
  unitPrice Decimal         @db.Decimal(10, 2)
  subtotal  Decimal         @db.Decimal(10, 2)
  booking   Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bundle    BookableBundle? @relation(fields: [bundleId], references: [id])
  item      BookableItem?   @relation(fields: [itemId], references: [id])

  @@index([bookingId])
  @@map("booking_line_items")
}

model Payment {
  id          String          @id @default(cuid())
  bookingId   String          @unique
  patronId    String?
  amount      Decimal         @db.Decimal(10, 2)
  currency    String          @default("GHS")
  provider    PaymentProvider
  providerRef String?         @unique
  status      PaymentStatus   @default(PENDING)
  metadata    Json?
  paidAt      DateTime?
  createdAt   DateTime        @default(now())
  booking     Booking         @relation(fields: [bookingId], references: [id])
  patron      Patron?         @relation(fields: [patronId], references: [id])
  receipt     Receipt?

  @@index([status])
  @@map("payments")
}

model Receipt {
  id            String   @id @default(cuid())
  bookingId     String   @unique
  paymentId     String   @unique
  receiptNumber String   @unique
  fileUrl       String?
  issuedAt      DateTime @default(now())
  booking       Booking  @relation(fields: [bookingId], references: [id])
  payment       Payment  @relation(fields: [paymentId], references: [id])

  @@map("receipts")
}

model PaymentConfig {
  id            String          @id @default(cuid())
  provider      PaymentProvider
  publicKey     String
  secretKey     String
  webhookSecret String?
  isActive      Boolean         @default(true)
  updatedAt     DateTime        @updatedAt

  @@unique([provider])
  @@map("payment_configs")
}

model Expense {
  id              String        @id @default(cuid())
  createdById     String
  approvedById    String?
  title           String
  narration       String
  amount          Decimal       @db.Decimal(10, 2)
  category        String
  status          ExpenseStatus @default(PENDING)
  receiptUrl      String?
  rejectionReason String?
  createdAt       DateTime      @default(now())
  approvedAt      DateTime?
  updatedAt       DateTime      @updatedAt
  approvedBy      User?         @relation("ApprovedExpenses", fields: [approvedById], references: [id])
  createdBy       User          @relation("CreatedExpenses", fields: [createdById], references: [id])

  @@index([status])
  @@map("expenses")
}

model Income {
  id           String   @id @default(cuid())
  recordedById String?
  title        String
  narration    String
  amount       Decimal  @db.Decimal(10, 2)
  category     String
  source       String?
  receivedAt   DateTime
  createdAt    DateTime @default(now())
  bookingId    String?  @unique
  booking      Booking? @relation(fields: [bookingId], references: [id])
  recordedBy   User?    @relation(fields: [recordedById], references: [id])

  @@index([receivedAt])
  @@map("income")
}

model MaintenanceRequest {
  id             String              @id @default(cuid())
  facilityId     String?
  requestedById  String
  assignedToId   String?
  title          String
  description    String
  priority       MaintenancePriority @default(MEDIUM)
  status         MaintenanceStatus   @default(OPEN)
  estimatedCost  Decimal?            @db.Decimal(10, 2)
  actualCost     Decimal?            @db.Decimal(10, 2)
  resolvedAt     DateTime?
  closedAt       DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  scheduledEnd   DateTime?
  scheduledStart DateTime?
  assignedTo     User?               @relation("AssignedMaint", fields: [assignedToId], references: [id])
  facility       Facility?           @relation(fields: [facilityId], references: [id])
  requestedBy    User                @relation("RequestedMaint", fields: [requestedById], references: [id])

  @@index([status, priority])
  @@map("maintenance_requests")
}

model InventoryCategory {
  id          String          @id @default(cuid())
  name        String
  description String?
  icon        String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       InventoryItem[]

  @@map("inventory_categories")
}

model InventoryItem {
  id              String                 @id @default(cuid())
  categoryId      String?
  name            String
  description     String?
  serialNumber    String?
  assetTag        String?                @unique
  condition       InventoryCondition     @default(GOOD)
  status          InventoryStatus        @default(AVAILABLE)
  location        String?
  quantity        Int                    @default(1)
  unitCost        Decimal?               @db.Decimal(10, 2)
  purchaseDate    DateTime?
  supplier        String?
  warrantyExp     DateTime?
  notes           String?
  images          String[]
  isActive        Boolean                @default(true)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  checkouts       InventoryCheckout[]
  category        InventoryCategory?     @relation(fields: [categoryId], references: [id])
  maintenanceLogs InventoryMaintenance[]

  @@index([status, isActive])
  @@map("inventory_items")
}

model InventoryCheckout {
  id             String              @id @default(cuid())
  itemId         String
  checkedOutById String
  returnedById   String?
  purpose        String
  quantity       Int                 @default(1)
  locationNote   String?
  checkedOutAt   DateTime            @default(now())
  dueBack        DateTime?
  returnedAt     DateTime?
  conditionOut   InventoryCondition  @default(GOOD)
  conditionIn    InventoryCondition?
  notes          String?
  checkedOutBy   User                @relation("CheckedOutBy", fields: [checkedOutById], references: [id])
  item           InventoryItem       @relation(fields: [itemId], references: [id])
  returnedBy     User?               @relation("ReturnedBy", fields: [returnedById], references: [id])

  @@index([itemId])
  @@index([checkedOutById])
  @@map("inventory_checkouts")
}

model InventoryMaintenance {
  id            String              @id @default(cuid())
  itemId        String
  requestedById String
  assignedToId  String?
  title         String
  description   String
  priority      MaintenancePriority @default(MEDIUM)
  status        MaintenanceStatus   @default(OPEN)
  estimatedCost Decimal?            @db.Decimal(10, 2)
  actualCost    Decimal?            @db.Decimal(10, 2)
  resolvedAt    DateTime?
  closedAt      DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  assignedTo    User?               @relation("InvMaintAssigned", fields: [assignedToId], references: [id])
  item          InventoryItem       @relation(fields: [itemId], references: [id])
  requestedBy   User                @relation("InvMaintRequested", fields: [requestedById], references: [id])

  @@index([status, priority])
  @@map("inventory_maintenance")
}

model Event {
  id             String    @id @default(cuid())
  facilityId     String
  createdById    String
  title          String
  description    String?
  startTime      DateTime
  endTime        DateTime
  isRecurring    Boolean   @default(false)
  recurrenceRule String?
  maxAttendees   Int?
  isPublic       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  bookings       Booking[]
  createdBy      User      @relation(fields: [createdById], references: [id])
  facility       Facility  @relation(fields: [facilityId], references: [id])

  @@index([startTime])
  @@map("events")
}

model NotificationLog {
  id          String   @id @default(cuid())
  type        String
  recipient   String
  subject     String?
  body        String
  status      String
  provider    String
  providerRef String?
  error       String?
  sentAt      DateTime @default(now())

  @@index([type, status])
  @@map("notification_logs")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([action, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

enum Role {
  SUPER_ADMIN
  FACILITY_MANAGER
  VICAR
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InventoryCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  DAMAGED
  DISPOSED
}

enum InventoryStatus {
  AVAILABLE
  IN_USE
  CHECKED_OUT
  UNDER_MAINTENANCE
  DISPOSED
  LOST
}

enum PaymentProvider {
  PAYSTACK
  HUBTEL
}

// ─── Booking Categories (dynamic, managed by FM / Super Admin) ────────────────

model BookingCategory {
  id         String   @id @default(cuid())
  name       String   @unique
  slug       String   @unique
  isCeremony Boolean  @default(false)
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("booking_categories")
}
