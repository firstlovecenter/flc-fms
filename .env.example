# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/cfms_db?sslmode=require"

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET="replace-with-32+-char-random-secret"
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ─── Encryption (for payment gateway keys at rest) ────────────────────────────
ENCRYPTION_KEY="replace-with-64-char-hex"
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ─── Redis (Upstash recommended on Vercel) ────────────────────────────────────
REDIS_URL="redis://:password@host:6379"

# ─── Email — Resend ───────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="CFMS <noreply@platform.com>"

# ─── SMS — Your BMS Gateway ───────────────────────────────────────────────────
BMS_API_URL="https://bms.codeslaw.dev/api/v1"
BMS_API_KEY="your-bms-api-key"
BMS_SENDER_ID="CFMS"

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://platform.com"

# ─── Google Auth (Unified Login Page) ───────────────────────────────────────
# Use the same OAuth client id for both server verification and browser SDK.
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

NODE_ENV="development"
